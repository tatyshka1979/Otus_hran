КонецПроцедуры

Процедура ПолучитьТоварПоАртикулу() Экспорт
	
	// 1. Подготовка параметров и генерация данных для выполнения функции.
	Артикул = "Kol67";     
	
	// 2. Выполнение функции.
	Товар = API_ОписаниеТовара.ПолучитьТоварПоАртикулу(Артикул);
	
	// 3. Проверка результата.
	ЮТест.ОжидаетЧто(Товар)
		.ИмеетТип("СправочникОбъект.Товары")  
		.Свойство("Артикул").Равно(Артикул)
		.Свойство("Наименование").Равно("Колбаса")
		;
		
КонецПроцедуры            
	
