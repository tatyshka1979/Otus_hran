Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("API_ОписаниеТовара").ВТранзакции()
			.ДобавитьТест("ПолучитьТоварПоАртикулу", "", "Позитив, Task-1") 
			.ДобавитьТест("ПолучитьТоварПоАртикулуНеНайден", "", "Негатив, Task-1")  
